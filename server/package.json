{
  "name": "ranchcord-server",
  "version": "1.1.4",
  "private": true,
  "description": "RanchCord chat server: accounts, friends, DMs, groups, uploads, realtime and call signaling",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch-path=src src/index.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/lib-storage": "^3.1172.0",
    "@aws-sdk/s3-request-presigner": "^3.1172.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "fastify": "^5.12.8",
    "image-size": "^2.1.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2"
  }
}
